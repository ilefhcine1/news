# Copy this file to .env and fill it in (never commit .env).

# ---- LLM: pick ONE provider -------------------------------------------
# Free cloud (recommended): key from https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Free cloud alternative: key from https://console.groq.com/keys
# LLM_PROVIDER=groq
# GROQ_API_KEY=

# 100% local, no key: install https://ollama.com then `ollama pull qwen2.5:7b`
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b

# Optional: override the provider's default model
# LLM_MODEL=

# ---- Email (Gmail App Password, needs 2-Step Verification) ------------
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
EMAIL_TO=you@gmail.com

# ---- Optional -----------------------------------------------------------
# NUM_STORIES=5
# LOOKBACK_HOURS=26
# DRY_RUN=1        # write digest.html instead of sending the email
