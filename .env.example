# Copiez ce fichier en .env et remplissez-le (ne jamais committer .env).

# ---- Modèle local (Ollama) ---------------------------------------------
# Aucune API d'IA externe : le modèle tourne sur ce PC.
LLM_MODEL=qwen3.5:4b
# OLLAMA_URL=http://localhost:11434
# Taille du contexte en tokens : plus grand = plus de RAM utilisée
NUM_CTX=8192
# Nombre de sujets candidats montrés au modèle pour choisir les 5 actus
MAX_CANDIDATES=60
# Mode « réflexion » de qwen3.5 : 0 = désactivé (recommandé sur CPU)
THINK=0

# ---- Email (Gmail : mot de passe d'application, validation en 2 étapes requise) ---
SMTP_USER=vous@gmail.com
SMTP_PASSWORD=
EMAIL_TO=vous@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# ---- Options ------------------------------------------------------------
# NUM_STORIES=5
# LOOKBACK_HOURS=26
# AUDIENCE=une manager IT et son équipe dans une entreprise de conseil ...
# DRY_RUN=1        # écrit digest.html au lieu d'envoyer l'email
